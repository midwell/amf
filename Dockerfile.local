#
# Local packaging Dockerfile: wraps a host-cross-compiled linux/amd64 `amf`
# binary (built in the go.work workspace so the li module resolves) into the
# same runtime image the upstream multi-stage Dockerfile produces. Used because
# the in-container build cannot resolve github.com/omec-project/li yet (task 8.3).

FROM alpine:3.24 AS amf

LABEL description="SD-Core AMF (LI-enabled, locally packaged)"

RUN apk add --no-cache bash

# Copy the pre-built executable (host: GOOS=linux GOARCH=amd64 CGO_ENABLED=0).
COPY amf /usr/local/bin/.
